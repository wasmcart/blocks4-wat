(module
  ;; Blocks 4: a complete falling-block game written directly in WebAssembly text.
  (memory (export "memory") 60)

  ;; ABI memory: info=0, audio cursor=80, pads=96, time=160, host=184,
  ;; save=208, framebuffer=4096, audio ring=3700000, board=3740000.
  (global $frame (mut i32) (i32.const 0))
  (global $rng (mut i32) (i32.const 0x41c64e6d))
  (global $piece (mut i32) (i32.const 0))
  (global $next (mut i32) (i32.const 1))
  (global $rot (mut i32) (i32.const 0))
  (global $px (mut i32) (i32.const 3))
  (global $py (mut i32) (i32.const -1))
  (global $drop (mut i32) (i32.const 0))
  (global $score (mut i32) (i32.const 0))
  (global $lines (mut i32) (i32.const 0))
  (global $level (mut i32) (i32.const 0))
  (global $over (mut i32) (i32.const 0))
  (global $paused (mut i32) (i32.const 0))
  (global $oldbtn (mut i32) (i32.const 0))
  (global $repeat (mut i32) (i32.const 0))
  (global $bagpos (mut i32) (i32.const 7))
  (global $locktimer (mut i32) (i32.const 0))
  (global $topout (mut i32) (i32.const 0))
  (global $phase (mut i32) (i32.const 0))
  (global $phase2 (mut i32) (i32.const 0))
  (global $phase3 (mut i32) (i32.const 0))
  (global $phasefx (mut i32) (i32.const 0))
  (global $sfxfreq (mut i32) (i32.const 0))
  (global $sfxleft (mut i32) (i32.const 0))

  ;; Read-only-by-convention state exports make deterministic playthrough
  ;; tests and external debuggers possible without changing gameplay memory.
  (export "debug_piece" (global $piece))
  (export "debug_next" (global $next))
  (export "debug_rotation" (global $rot))
  (export "debug_x" (global $px))
  (export "debug_y" (global $py))
  (export "debug_lock_timer" (global $locktimer))
  (export "debug_bag_position" (global $bagpos))
  (export "debug_score" (global $score))
  (export "debug_lines" (global $lines))
  (export "debug_game_over" (global $over))

  ;; Seven tetrominoes, four rotations each, as little-endian 4x4 bitmasks.
  (data (i32.const 3741000)
    "\f0\00\44\44\00\0f\22\22\66\00\66\00\66\00\66\00"
    "\72\00\62\02\70\02\32\02\36\00\62\04\60\03\31\02"
    "\63\00\64\02\30\06\32\01\74\00\22\06\70\01\23\02"
    "\71\00\26\02\70\04\22\03")
  (data (i32.const 3742000) "BLOCKS 4SCORELINESLEVELNEXTPAUSEDGAME OVERA RESTART")
  (data (i32.const 3742300) "BEST")

  (func $rand (result i32)
    (global.set $rng (i32.xor (global.get $rng) (i32.shl (global.get $rng) (i32.const 13))))
    (global.set $rng (i32.xor (global.get $rng) (i32.shr_u (global.get $rng) (i32.const 17))))
    (global.set $rng (i32.xor (global.get $rng) (i32.shl (global.get $rng) (i32.const 5))))
    (global.get $rng))

  (func $tone (param $freq i32) (param $samples i32)
    (global.set $sfxfreq (local.get $freq))
    (global.set $sfxleft (local.get $samples)))

  (func $lead_note (result i32) (local $s i32)
    (local.set $s (i32.and (i32.div_u (global.get $frame) (i32.const 15)) (i32.const 15)))
    (if (i32.eq (local.get $s) (i32.const 0)) (then (return (i32.const 330))))
    (if (i32.eq (local.get $s) (i32.const 1)) (then (return (i32.const 392))))
    (if (i32.eq (local.get $s) (i32.const 2)) (then (return (i32.const 440))))
    (if (i32.eq (local.get $s) (i32.const 3)) (then (return (i32.const 523))))
    (if (i32.eq (local.get $s) (i32.const 4)) (then (return (i32.const 494))))
    (if (i32.eq (local.get $s) (i32.const 5)) (then (return (i32.const 440))))
    (if (i32.eq (local.get $s) (i32.const 6)) (then (return (i32.const 392))))
    (if (i32.eq (local.get $s) (i32.const 7)) (then (return (i32.const 330))))
    (if (i32.eq (local.get $s) (i32.const 8)) (then (return (i32.const 294))))
    (if (i32.eq (local.get $s) (i32.const 9)) (then (return (i32.const 330))))
    (if (i32.eq (local.get $s) (i32.const 10)) (then (return (i32.const 392))))
    (if (i32.eq (local.get $s) (i32.const 11)) (then (return (i32.const 494))))
    (if (i32.eq (local.get $s) (i32.const 12)) (then (return (i32.const 587))))
    (if (i32.eq (local.get $s) (i32.const 13)) (then (return (i32.const 523))))
    (if (i32.eq (local.get $s) (i32.const 14)) (then (return (i32.const 392))))
    (if (i32.eq (local.get $s) (i32.const 15)) (then (return (i32.const 0))))
    (i32.const 0))

  (func $bass_note (result i32) (local $s i32)
    (local.set $s (i32.and (i32.div_u (global.get $frame) (i32.const 60)) (i32.const 3)))
    (if (i32.eq (local.get $s) (i32.const 0)) (then (return (i32.const 110))))
    (if (i32.eq (local.get $s) (i32.const 1)) (then (return (i32.const 131))))
    (if (i32.eq (local.get $s) (i32.const 2)) (then (return (i32.const 147))))
    (if (i32.eq (local.get $s) (i32.const 3)) (then (return (i32.const 98))))
    (i32.const 98))

  (func $arp_note (result i32) (local $s i32)
    (local.set $s (i32.and (i32.div_u (global.get $frame) (i32.const 8)) (i32.const 7)))
    (if (i32.eq (local.get $s) (i32.const 0)) (then (return (i32.const 660))))
    (if (i32.eq (local.get $s) (i32.const 1)) (then (return (i32.const 784))))
    (if (i32.eq (local.get $s) (i32.const 2)) (then (return (i32.const 880))))
    (if (i32.eq (local.get $s) (i32.const 3)) (then (return (i32.const 784))))
    (if (i32.eq (local.get $s) (i32.const 4)) (then (return (i32.const 659))))
    (if (i32.eq (local.get $s) (i32.const 5)) (then (return (i32.const 784))))
    (if (i32.eq (local.get $s) (i32.const 6)) (then (return (i32.const 988))))
    (if (i32.eq (local.get $s) (i32.const 7)) (then (return (i32.const 784))))
    (i32.const 784))

  (func $audio
    (local $i i32) (local $cursor i32) (local $freq i32) (local $bass i32) (local $arp i32)
    (local $leadSample f32) (local $bassSample f32) (local $arpSample f32)
    (local $fxSample f32) (local $left f32) (local $right f32) (local $addr i32)
    (local.set $cursor (i32.load (i32.const 80)))
    (local.set $freq (call $lead_note))
    (local.set $bass (call $bass_note))
    (local.set $arp (call $arp_note))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (i32.const 800)))

      ;; Lead voice: pulse wave with a short gap between notes.
      (if (i32.and (local.get $freq)
            (i32.lt_u (i32.rem_u (global.get $frame) (i32.const 15)) (i32.const 13)))
        (then
          (global.set $phase (i32.add (global.get $phase) (local.get $freq)))
          (if (i32.ge_u (global.get $phase) (i32.const 48000))
            (then (global.set $phase (i32.sub (global.get $phase) (i32.const 48000)))))
          (local.set $leadSample
            (select (f32.const 0.028) (f32.const -0.028)
              (i32.lt_u (global.get $phase) (i32.const 12000)))))
        (else (local.set $leadSample (f32.const 0))))

      ;; Bass voice: square wave one or two octaves below the melody.
      (global.set $phase2 (i32.add (global.get $phase2) (local.get $bass)))
      (if (i32.ge_u (global.get $phase2) (i32.const 48000))
        (then (global.set $phase2 (i32.sub (global.get $phase2) (i32.const 48000)))))
      (local.set $bassSample
        (select (f32.const 0.020) (f32.const -0.020)
          (i32.lt_u (global.get $phase2) (i32.const 24000))))

      ;; Fast arpeggio is mixed wider on the right channel.
      (global.set $phase3 (i32.add (global.get $phase3) (local.get $arp)))
      (if (i32.ge_u (global.get $phase3) (i32.const 48000))
        (then (global.set $phase3 (i32.sub (global.get $phase3) (i32.const 48000)))))
      (local.set $arpSample
        (select (f32.const 0.012) (f32.const -0.012)
          (i32.lt_u (global.get $phase3) (i32.const 18000))))

      ;; Event effects use their own oscillator so they do not reset the music.
      (local.set $fxSample (f32.const 0))
      (if (i32.gt_s (global.get $sfxleft) (i32.const 0))
        (then
          (global.set $phasefx (i32.add (global.get $phasefx) (global.get $sfxfreq)))
          (if (i32.ge_u (global.get $phasefx) (i32.const 48000))
            (then (global.set $phasefx (i32.sub (global.get $phasefx) (i32.const 48000)))))
          (local.set $fxSample
            (select (f32.const 0.060) (f32.const -0.060)
              (i32.lt_u (global.get $phasefx) (i32.const 24000))))
          (global.set $sfxleft (i32.sub (global.get $sfxleft) (i32.const 1)))))

      (local.set $left
        (f32.add (local.get $fxSample)
          (f32.add (f32.mul (local.get $leadSample) (f32.const 0.90))
            (f32.add (local.get $bassSample) (f32.mul (local.get $arpSample) (f32.const 0.55))))))
      (local.set $right
        (f32.add (local.get $fxSample)
          (f32.add (local.get $leadSample)
            (f32.add (f32.mul (local.get $bassSample) (f32.const 0.85)) (local.get $arpSample)))))
      (local.set $addr (i32.add (i32.const 3700000)
        (i32.mul (i32.and (local.get $cursor) (i32.const 4095)) (i32.const 8))))
      (f32.store (local.get $addr) (local.get $left))
      (f32.store offset=4 (local.get $addr) (local.get $right))
      (local.set $cursor (i32.add (local.get $cursor) (i32.const 1)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (i32.store (i32.const 80) (local.get $cursor)))

  (func $fill (param $x i32) (param $y i32) (param $w i32) (param $h i32) (param $c i32)
    (local $xx i32) (local $yy i32) (local $sy i32) (local $addr i32)
    (local.set $yy (i32.const 0))
    (block $ydone (loop $yl
      (br_if $ydone (i32.ge_s (local.get $yy) (local.get $h)))
      (local.set $xx (i32.const 0))
      (block $xdone (loop $xl
        (br_if $xdone (i32.ge_s (local.get $xx) (local.get $w)))
        (if (i32.and
              (i32.and (i32.ge_s (i32.add (local.get $x) (local.get $xx)) (i32.const 0))
                       (i32.lt_s (i32.add (local.get $x) (local.get $xx)) (i32.const 320)))
              (i32.and (i32.ge_s (i32.add (local.get $y) (local.get $yy)) (i32.const 0))
                       (i32.lt_s (i32.add (local.get $y) (local.get $yy)) (i32.const 240))))
          (then
            (local.set $sy (i32.const 0))
            (block $sdone (loop $sl
              (br_if $sdone (i32.ge_u (local.get $sy) (i32.const 3)))
              (local.set $addr
                (i32.add (i32.const 4096)
                  (i32.mul
                    (i32.add
                      (i32.mul
                        (i32.add
                          (i32.mul (i32.add (local.get $y) (local.get $yy)) (i32.const 3))
                          (local.get $sy))
                        (i32.const 1280))
                      (i32.add (i32.const 160)
                        (i32.mul (i32.add (local.get $x) (local.get $xx)) (i32.const 3))))
                    (i32.const 4))))
              (i32.store (local.get $addr) (local.get $c))
              (i32.store offset=4 (local.get $addr) (local.get $c))
              (i32.store offset=8 (local.get $addr) (local.get $c))
              (local.set $sy (i32.add (local.get $sy) (i32.const 1))) (br $sl)))))
        (local.set $xx (i32.add (local.get $xx) (i32.const 1))) (br $xl)))
      (local.set $yy (i32.add (local.get $yy) (i32.const 1))) (br $yl))))

  (func $glyph (param $c i32) (result i32)
    (if (i32.eq (local.get $c) (i32.const 48)) (then (return (i32.const 31599))))
    (if (i32.eq (local.get $c) (i32.const 49)) (then (return (i32.const 29850))))
    (if (i32.eq (local.get $c) (i32.const 50)) (then (return (i32.const 29667))))
    (if (i32.eq (local.get $c) (i32.const 51)) (then (return (i32.const 14819))))
    (if (i32.eq (local.get $c) (i32.const 52)) (then (return (i32.const 18925))))
    (if (i32.eq (local.get $c) (i32.const 53)) (then (return (i32.const 14543))))
    (if (i32.eq (local.get $c) (i32.const 54)) (then (return (i32.const 31694))))
    (if (i32.eq (local.get $c) (i32.const 55)) (then (return (i32.const 9383))))
    (if (i32.eq (local.get $c) (i32.const 56)) (then (return (i32.const 31727))))
    (if (i32.eq (local.get $c) (i32.const 57)) (then (return (i32.const 14831))))
    (if (i32.eq (local.get $c) (i32.const 65)) (then (return (i32.const 23530))))
    (if (i32.eq (local.get $c) (i32.const 66)) (then (return (i32.const 15083))))
    (if (i32.eq (local.get $c) (i32.const 67)) (then (return (i32.const 25166))))
    (if (i32.eq (local.get $c) (i32.const 68)) (then (return (i32.const 15211))))
    (if (i32.eq (local.get $c) (i32.const 69)) (then (return (i32.const 29391))))
    (if (i32.eq (local.get $c) (i32.const 70)) (then (return (i32.const 4815))))
    (if (i32.eq (local.get $c) (i32.const 71)) (then (return (i32.const 27470))))
    (if (i32.eq (local.get $c) (i32.const 72)) (then (return (i32.const 23533))))
    (if (i32.eq (local.get $c) (i32.const 73)) (then (return (i32.const 29847))))
    (if (i32.eq (local.get $c) (i32.const 75)) (then (return (i32.const 23277))))
    (if (i32.eq (local.get $c) (i32.const 76)) (then (return (i32.const 29257))))
    (if (i32.eq (local.get $c) (i32.const 77)) (then (return (i32.const 23549))))
    (if (i32.eq (local.get $c) (i32.const 78)) (then (return (i32.const 24573))))
    (if (i32.eq (local.get $c) (i32.const 79)) (then (return (i32.const 11114))))
    (if (i32.eq (local.get $c) (i32.const 80)) (then (return (i32.const 4843))))
    (if (i32.eq (local.get $c) (i32.const 82)) (then (return (i32.const 23275))))
    (if (i32.eq (local.get $c) (i32.const 83)) (then (return (i32.const 14478))))
    (if (i32.eq (local.get $c) (i32.const 84)) (then (return (i32.const 9367))))
    (if (i32.eq (local.get $c) (i32.const 85)) (then (return (i32.const 31597))))
    (if (i32.eq (local.get $c) (i32.const 86)) (then (return (i32.const 11117))))
    (if (i32.eq (local.get $c) (i32.const 87)) (then (return (i32.const 24557))))
    (if (i32.eq (local.get $c) (i32.const 88)) (then (return (i32.const 23213))))
    (if (i32.eq (local.get $c) (i32.const 89)) (then (return (i32.const 9389))))
    (if (i32.eq (local.get $c) (i32.const 90)) (then (return (i32.const 29351))))
    (i32.const 0))

  (func $text (param $p i32) (param $n i32) (param $x i32) (param $y i32) (param $s i32) (param $c i32)
    (local $i i32) (local $b i32) (local $gx i32) (local $gy i32)
    (block $done (loop $chars
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $b (call $glyph (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
      (local.set $gy (i32.const 0))
      (block $gyd (loop $gyl
        (br_if $gyd (i32.ge_u (local.get $gy) (i32.const 5)))
        (local.set $gx (i32.const 0))
        (block $gxd (loop $gxl
          (br_if $gxd (i32.ge_u (local.get $gx) (i32.const 3)))
          (if (i32.and (i32.shr_u (local.get $b)
                    (i32.add (i32.mul (local.get $gy) (i32.const 3)) (local.get $gx))) (i32.const 1))
            (then (call $fill
              (i32.add (local.get $x) (i32.mul (i32.add (i32.mul (local.get $i) (i32.const 4)) (local.get $gx)) (local.get $s)))
              (i32.add (local.get $y) (i32.mul (local.get $gy) (local.get $s)))
              (local.get $s) (local.get $s) (local.get $c))))
          (local.set $gx (i32.add (local.get $gx) (i32.const 1))) (br $gxl)))
        (local.set $gy (i32.add (local.get $gy) (i32.const 1))) (br $gyl)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $chars))))

  (func $number (param $v i32) (param $x i32) (param $y i32) (param $c i32)
    (local $p i32) (local $n i32) (local $d i32)
    (local.set $p (i32.const 3742100))
    (if (i32.eqz (local.get $v))
      (then (i32.store8 (local.get $p) (i32.const 48)) (local.set $n (i32.const 1)))
      (else (block $done (loop $digits
        (br_if $done (i32.eqz (local.get $v)))
        (local.set $d (i32.rem_u (local.get $v) (i32.const 10)))
        (i32.store8 (i32.add (local.get $p) (local.get $n)) (i32.add (local.get $d) (i32.const 48)))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $v (i32.div_u (local.get $v) (i32.const 10))) (br $digits)))))
    (local.set $d (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $d) (i32.div_u (local.get $n) (i32.const 2))))
      (local.set $v (i32.load8_u (i32.add (local.get $p) (local.get $d))))
      (i32.store8 (i32.add (local.get $p) (local.get $d))
        (i32.load8_u (i32.add (i32.add (local.get $p) (local.get $n)) (i32.sub (i32.const -1) (local.get $d)))))
      (i32.store8 (i32.add (i32.add (local.get $p) (local.get $n)) (i32.sub (i32.const -1) (local.get $d))) (local.get $v))
      (local.set $d (i32.add (local.get $d) (i32.const 1))) (br $rl)))
    (call $text (local.get $p) (local.get $n) (local.get $x) (local.get $y) (i32.const 2) (local.get $c)))

  (func $mask (param $p i32) (param $r i32) (result i32)
    (i32.load16_u (i32.add (i32.const 3741000)
      (i32.mul (i32.add (i32.mul (local.get $p) (i32.const 4)) (i32.and (local.get $r) (i32.const 3))) (i32.const 2)))))

  (func $fits (param $p i32) (param $r i32) (param $ox i32) (param $oy i32) (result i32)
    (local $i i32) (local $x i32) (local $y i32) (local $m i32)
    (local.set $m (call $mask (local.get $p) (local.get $r)))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (i32.const 16)))
      (if (i32.and (i32.shr_u (local.get $m) (local.get $i)) (i32.const 1))
        (then
          (local.set $x (i32.add (local.get $ox) (i32.and (local.get $i) (i32.const 3))))
          (local.set $y (i32.add (local.get $oy) (i32.shr_u (local.get $i) (i32.const 2))))
          (if (i32.or (i32.or (i32.lt_s (local.get $x) (i32.const 0)) (i32.ge_s (local.get $x) (i32.const 10)))
                      (i32.ge_s (local.get $y) (i32.const 20))) (then (return (i32.const 0))))
          (if (i32.and (i32.ge_s (local.get $y) (i32.const 0))
                    (i32.load8_u (i32.add (i32.const 3740000)
                      (i32.add (i32.mul (local.get $y) (i32.const 10)) (local.get $x)))))
            (then (return (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (i32.const 1))

  (func $bag_refill (local $i i32) (local $j i32) (local $a i32)
    (local.set $i (i32.const 0))
    (block $fd (loop $fl
      (br_if $fd (i32.ge_u (local.get $i) (i32.const 7)))
      (i32.store8 (i32.add (i32.const 3740300) (local.get $i)) (local.get $i))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $fl)))
    (local.set $i (i32.const 6))
    (block $sd (loop $sl
      (br_if $sd (i32.le_s (local.get $i) (i32.const 0)))
      (local.set $j (i32.rem_u (call $rand) (i32.add (local.get $i) (i32.const 1))))
      (local.set $a (i32.load8_u (i32.add (i32.const 3740300) (local.get $i))))
      (i32.store8 (i32.add (i32.const 3740300) (local.get $i))
        (i32.load8_u (i32.add (i32.const 3740300) (local.get $j))))
      (i32.store8 (i32.add (i32.const 3740300) (local.get $j)) (local.get $a))
      (local.set $i (i32.sub (local.get $i) (i32.const 1))) (br $sl)))
    (global.set $bagpos (i32.const 0)))

  (func $bag_next (result i32) (local $v i32)
    (if (i32.ge_u (global.get $bagpos) (i32.const 7)) (then (call $bag_refill)))
    (local.set $v (i32.load8_u (i32.add (i32.const 3740300) (global.get $bagpos))))
    (global.set $bagpos (i32.add (global.get $bagpos) (i32.const 1)))
    (local.get $v))

  (func $spawn
    (global.set $piece (global.get $next))
    (global.set $next (call $bag_next))
    (global.set $rot (i32.const 0)) (global.set $px (i32.const 3)) (global.set $py (i32.const -1))
    (global.set $drop (i32.const 0)) (global.set $locktimer (i32.const 0))
    (if (i32.eqz (call $fits (global.get $piece) (i32.const 0) (i32.const 3) (i32.const -1)))
      (then
        (global.set $over (i32.const 1))
        (call $tone (i32.const 110) (i32.const 8000))
        (if (i32.gt_u (global.get $score) (i32.load (i32.const 208)))
          (then (i32.store (i32.const 208) (global.get $score)))))))

  (func $reset (local $i i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (i32.const 200)))
      (i32.store8 (i32.add (i32.const 3740000) (local.get $i)) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (global.set $score (i32.const 0)) (global.set $lines (i32.const 0))
    (global.set $level (i32.const 0)) (global.set $drop (i32.const 0))
    (global.set $locktimer (i32.const 0)) (global.set $bagpos (i32.const 7))
    (global.set $over (i32.const 0)) (global.set $paused (i32.const 0))
    (global.set $next (call $bag_next)) (call $spawn))

  (func $lock (local $i i32) (local $x i32) (local $y i32) (local $m i32)
    (global.set $topout (i32.const 0))
    (local.set $m (call $mask (global.get $piece) (global.get $rot)))
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (i32.const 16)))
      (if (i32.and (i32.shr_u (local.get $m) (local.get $i)) (i32.const 1))
        (then
          (local.set $x (i32.add (global.get $px) (i32.and (local.get $i) (i32.const 3))))
          (local.set $y (i32.add (global.get $py) (i32.shr_u (local.get $i) (i32.const 2))))
          (if (i32.lt_s (local.get $y) (i32.const 0))
            (then (global.set $topout (i32.const 1)))
            (else
              (i32.store8 (i32.add (i32.const 3740000)
                (i32.add (i32.mul (local.get $y) (i32.const 10)) (local.get $x)))
                (i32.add (global.get $piece) (i32.const 1)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

  (func $clear (local $y i32) (local $x i32) (local $yy i32) (local $full i32) (local $count i32)
    (local.set $y (i32.const 19))
    (block $done (loop $rows
      (br_if $done (i32.lt_s (local.get $y) (i32.const 0)))
      (local.set $full (i32.const 1)) (local.set $x (i32.const 0))
      (block $xd (loop $xl (br_if $xd (i32.ge_u (local.get $x) (i32.const 10)))
        (if (i32.eqz (i32.load8_u (i32.add (i32.const 3740000) (i32.add (i32.mul (local.get $y) (i32.const 10)) (local.get $x)))))
          (then (local.set $full (i32.const 0))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xl)))
      (if (local.get $full)
        (then
          (local.set $count (i32.add (local.get $count) (i32.const 1)))
          (local.set $yy (local.get $y))
          (block $sd (loop $sl (br_if $sd (i32.le_s (local.get $yy) (i32.const 0)))
            (local.set $x (i32.const 0))
            (block $cd (loop $cl (br_if $cd (i32.ge_u (local.get $x) (i32.const 10)))
              (i32.store8 (i32.add (i32.const 3740000) (i32.add (i32.mul (local.get $yy) (i32.const 10)) (local.get $x)))
                (i32.load8_u (i32.add (i32.const 3739990) (i32.add (i32.mul (local.get $yy) (i32.const 10)) (local.get $x)))))
              (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $cl)))
            (local.set $yy (i32.sub (local.get $yy) (i32.const 1))) (br $sl)))
          (i64.store (i32.const 3740000) (i64.const 0)) (i32.store16 (i32.const 3740008) (i32.const 0))
          (br $rows)))
      (local.set $y (i32.sub (local.get $y) (i32.const 1))) (br $rows)))
    (if (i32.gt_u (local.get $count) (i32.const 0))
      (then
        (global.set $score (i32.add (global.get $score)
          (i32.mul
            (select
              (select (i32.const 800) (i32.const 500) (i32.eq (local.get $count) (i32.const 4)))
              (select (i32.const 300) (i32.const 100) (i32.eq (local.get $count) (i32.const 2)))
              (i32.ge_u (local.get $count) (i32.const 3)))
            (i32.add (global.get $level) (i32.const 1)))))
        (global.set $lines (i32.add (global.get $lines) (local.get $count)))
        (global.set $level (i32.div_u (global.get $lines) (i32.const 10)))
        (call $tone (i32.add (i32.const 660) (i32.mul (local.get $count) (i32.const 110))) (i32.const 1800)))))

  (func $finish_piece
    (call $lock)
    (if (global.get $topout)
      (then
        (global.set $over (i32.const 1)) (call $tone (i32.const 110) (i32.const 8000))
        (if (i32.gt_u (global.get $score) (i32.load (i32.const 208)))
          (then (i32.store (i32.const 208) (global.get $score)))))
      (else (call $clear) (call $spawn))))

  (func $try_rotate (param $delta i32) (result i32) (local $nr i32)
    (local.set $nr (i32.and (i32.add (global.get $rot) (local.get $delta)) (i32.const 3)))
    (if (call $fits (global.get $piece) (local.get $nr) (global.get $px) (global.get $py))
      (then (global.set $rot (local.get $nr)) (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (if (call $fits (global.get $piece) (local.get $nr) (i32.sub (global.get $px) (i32.const 1)) (global.get $py))
      (then (global.set $px (i32.sub (global.get $px) (i32.const 1))) (global.set $rot (local.get $nr))
        (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (if (call $fits (global.get $piece) (local.get $nr) (i32.add (global.get $px) (i32.const 1)) (global.get $py))
      (then (global.set $px (i32.add (global.get $px) (i32.const 1))) (global.set $rot (local.get $nr))
        (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (if (call $fits (global.get $piece) (local.get $nr) (i32.sub (global.get $px) (i32.const 2)) (global.get $py))
      (then (global.set $px (i32.sub (global.get $px) (i32.const 2))) (global.set $rot (local.get $nr))
        (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (if (call $fits (global.get $piece) (local.get $nr) (i32.add (global.get $px) (i32.const 2)) (global.get $py))
      (then (global.set $px (i32.add (global.get $px) (i32.const 2))) (global.set $rot (local.get $nr))
        (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (if (call $fits (global.get $piece) (local.get $nr) (global.get $px) (i32.sub (global.get $py) (i32.const 1)))
      (then (global.set $py (i32.sub (global.get $py) (i32.const 1))) (global.set $rot (local.get $nr))
        (global.set $locktimer (i32.const 0)) (return (i32.const 1))))
    (i32.const 0))

  ;; Final safety invariant: the active piece must never share a cell with the
  ;; settled board. Recover upward if external state or a future transition
  ;; ever violates it; if no legal position remains, top out before drawing.
  (func $ensure_active_valid
    (if (global.get $over) (then (return)))
    (block $done (loop $lift
      (br_if $done (call $fits (global.get $piece) (global.get $rot)
        (global.get $px) (global.get $py)))
      (global.set $py (i32.sub (global.get $py) (i32.const 1)))
      (if (i32.lt_s (global.get $py) (i32.const -4))
        (then
          (global.set $over (i32.const 1))
          (call $tone (i32.const 110) (i32.const 8000))
          (return)))
      (br $lift))))

  (func $color (param $v i32) (result i32)
    (if (i32.eq (local.get $v) (i32.const 1)) (then (return (i32.const 0x0000e8f8))))
    (if (i32.eq (local.get $v) (i32.const 2)) (then (return (i32.const 0x00f8e840))))
    (if (i32.eq (local.get $v) (i32.const 3)) (then (return (i32.const 0x00c060f8))))
    (if (i32.eq (local.get $v) (i32.const 4)) (then (return (i32.const 0x0040e878))))
    (if (i32.eq (local.get $v) (i32.const 5)) (then (return (i32.const 0x00f04858))))
    (if (i32.eq (local.get $v) (i32.const 6)) (then (return (i32.const 0x00f89838))))
    (i32.const 0x004878f8))

  (func $cell (param $x i32) (param $y i32) (param $v i32)
    (call $fill (local.get $x) (local.get $y) (i32.const 10) (i32.const 10) (call $color (local.get $v)))
    (call $fill (i32.add (local.get $x) (i32.const 1)) (i32.add (local.get $y) (i32.const 1))
      (i32.const 8) (i32.const 2) (i32.const 0x00ffffff)))

  (func $draw_piece (param $p i32) (param $r i32) (param $ox i32) (param $oy i32) (param $ghost i32)
    (local $i i32) (local $m i32) (local $x i32) (local $y i32)
    (local.set $m (call $mask (local.get $p) (local.get $r)))
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (i32.const 16)))
      (if (i32.and (i32.shr_u (local.get $m) (local.get $i)) (i32.const 1))
        (then
          (local.set $x (i32.add (local.get $ox) (i32.and (local.get $i) (i32.const 3))))
          (local.set $y (i32.add (local.get $oy) (i32.shr_u (local.get $i) (i32.const 2))))
          (if (i32.ge_s (local.get $y) (i32.const 0))
            (then
              (if (local.get $ghost)
                (then
                  (call $fill (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                    (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11)))
                    (i32.const 9) (i32.const 1) (i32.const 0x00605888))
                  (call $fill (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                    (i32.add (i32.const 18) (i32.mul (local.get $y) (i32.const 11)))
                    (i32.const 9) (i32.const 1) (i32.const 0x00605888))
                  (call $fill (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                    (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11)))
                    (i32.const 1) (i32.const 9) (i32.const 0x00605888))
                  (call $fill (i32.add (i32.const 84) (i32.mul (local.get $x) (i32.const 11)))
                    (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11)))
                    (i32.const 1) (i32.const 9) (i32.const 0x00605888)))
                (else (call $cell (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                         (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11)))
                         (i32.add (local.get $p) (i32.const 1)))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

  (func $draw (local $x i32) (local $y i32) (local $v i32) (local $gy i32)
    (call $fill (i32.const 0) (i32.const 0) (i32.const 320) (i32.const 240) (i32.const 0x00100c20))
    (call $fill (i32.const 68) (i32.const 2) (i32.const 126) (i32.const 236) (i32.const 0x00604088))
    (call $fill (i32.const 72) (i32.const 6) (i32.const 118) (i32.const 228) (i32.const 0x00070616))
    (local.set $y (i32.const 0))
    (block $yd (loop $yl (br_if $yd (i32.ge_u (local.get $y) (i32.const 20)))
      (local.set $x (i32.const 0))
      (block $xd (loop $xl (br_if $xd (i32.ge_u (local.get $x) (i32.const 10)))
        (local.set $v (i32.load8_u (i32.add (i32.const 3740000) (i32.add (i32.mul (local.get $y) (i32.const 10)) (local.get $x)))))
        (if (local.get $v)
          (then (call $cell (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                   (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11))) (local.get $v)))
          (else (call $fill (i32.add (i32.const 76) (i32.mul (local.get $x) (i32.const 11)))
                   (i32.add (i32.const 10) (i32.mul (local.get $y) (i32.const 11)))
                   (i32.const 10) (i32.const 10) (i32.const 0x00141228))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $yl)))
    (if (i32.eqz (global.get $over))
      (then
        (local.set $gy (global.get $py))
        (block $gd (loop $gl
          (br_if $gd (i32.eqz (call $fits (global.get $piece) (global.get $rot) (global.get $px) (i32.add (local.get $gy) (i32.const 1)))))
          (local.set $gy (i32.add (local.get $gy) (i32.const 1))) (br $gl)))
        (call $draw_piece (global.get $piece) (global.get $rot) (global.get $px) (local.get $gy) (i32.const 1))
        (call $draw_piece (global.get $piece) (global.get $rot) (global.get $px) (global.get $py) (i32.const 0))))
    (call $text (i32.const 3742000) (i32.const 8) (i32.const 8) (i32.const 10) (i32.const 3) (i32.const 0x00f0d060))
    (call $text (i32.const 3742008) (i32.const 5) (i32.const 204) (i32.const 20) (i32.const 2) (i32.const 0x009088b8))
    (call $number (global.get $score) (i32.const 204) (i32.const 34) (i32.const 0x00ffffff))
    (call $text (i32.const 3742013) (i32.const 5) (i32.const 204) (i32.const 62) (i32.const 2) (i32.const 0x009088b8))
    (call $number (global.get $lines) (i32.const 204) (i32.const 76) (i32.const 0x00ffffff))
    (call $text (i32.const 3742018) (i32.const 5) (i32.const 204) (i32.const 104) (i32.const 2) (i32.const 0x009088b8))
    (call $number (global.get $level) (i32.const 204) (i32.const 118) (i32.const 0x00ffffff))
    (call $text (i32.const 3742023) (i32.const 4) (i32.const 204) (i32.const 148) (i32.const 2) (i32.const 0x009088b8))
    (call $draw_piece (global.get $next) (i32.const 0) (i32.const 13) (i32.const 14) (i32.const 0))
    (call $text (i32.const 3742300) (i32.const 4) (i32.const 204) (i32.const 202) (i32.const 2) (i32.const 0x009088b8))
    (call $number (i32.load (i32.const 208)) (i32.const 204) (i32.const 216) (i32.const 0x00f0d060))
    (if (global.get $paused)
      (then (call $fill (i32.const 88) (i32.const 95) (i32.const 86) (i32.const 34) (i32.const 0x00000000))
            (call $text (i32.const 3742027) (i32.const 6) (i32.const 95) (i32.const 104) (i32.const 3) (i32.const 0x00ffffff))))
    (if (global.get $over)
      (then (call $fill (i32.const 80) (i32.const 88) (i32.const 102) (i32.const 58) (i32.const 0x00200020))
            (call $text (i32.const 3742033) (i32.const 9) (i32.const 86) (i32.const 98) (i32.const 2) (i32.const 0x00f05060))
            (call $text (i32.const 3742042) (i32.const 9) (i32.const 88) (i32.const 122) (i32.const 2) (i32.const 0x00ffffff)))))

  (func (export "wc_get_info") (result i32)
    (i32.store (i32.const 0) (i32.const 3)) (i32.store (i32.const 4) (i32.const 1280))
    (i32.store (i32.const 8) (i32.const 720)) (i32.store (i32.const 12) (i32.const 4096))
    (i32.store (i32.const 16) (i32.const 3700000)) (i32.store (i32.const 20) (i32.const 4096))
    (i32.store (i32.const 24) (i32.const 80)) (i32.store (i32.const 28) (i32.const 96))
    (i32.store (i32.const 32) (i32.const 208)) (i32.store (i32.const 36) (i32.const 16))
    (i32.store (i32.const 40) (i32.const 160)) (i32.store (i32.const 44) (i32.const 184))
    (i32.store (i32.const 48) (i32.const 1)) (i32.store (i32.const 52) (i32.const 48000))
    (i64.store (i32.const 56) (i64.const 0)) (i64.store (i32.const 64) (i64.const 0))
    (i32.const 0))

  (func (export "wc_init")
    (i32.store (i32.const 80) (i32.const 0))
    (global.set $rng (i32.xor (i32.const 0x41c64e6d) (i32.load (i32.const 168))))
    (call $reset))

  (func (export "wc_render")
    (local $btn i32) (local $pressed i32) (local $delay i32) (local $restarted i32)
    (global.set $frame (i32.add (global.get $frame) (i32.const 1)))
    (local.set $btn (i32.load16_u (i32.const 96)))
    (local.set $pressed (i32.and (local.get $btn) (i32.xor (global.get $oldbtn) (i32.const -1))))

    (if (i32.and (local.get $pressed) (i32.const 64))
      (then (global.set $paused (i32.xor (global.get $paused) (i32.const 1)))
        (call $tone (i32.const 520) (i32.const 500))))
    (if (i32.and (global.get $over) (i32.and (local.get $pressed) (i32.const 1)))
      (then (call $reset) (local.set $restarted (i32.const 1))))

    (if (i32.and
          (i32.and (i32.eqz (global.get $over)) (i32.eqz (global.get $paused)))
          (i32.eqz (local.get $restarted)))
      (then (block $actions
        ;; A or Up rotates clockwise; B/X/Y rotates counter-clockwise.
        (if (i32.and (local.get $pressed) (i32.const 257))
          (then (if (call $try_rotate (i32.const 1))
            (then (call $tone (i32.const 500) (i32.const 300))))))
        (if (i32.and (local.get $pressed) (i32.const 14))
          (then (if (call $try_rotate (i32.const 3))
            (then (call $tone (i32.const 420) (i32.const 300))))))

        ;; Guideline-like delayed auto shift: wait 10 frames, then repeat every 3.
        (if (i32.or (i32.and (local.get $pressed) (i32.const 3072))
              (i32.and (i32.and (local.get $btn) (i32.const 3072))
                (i32.and (i32.gt_u (global.get $repeat) (i32.const 10))
                  (i32.eqz (i32.rem_u (i32.sub (global.get $repeat) (i32.const 10)) (i32.const 3))))))
          (then
            (if (i32.and (local.get $btn) (i32.const 1024))
              (then (if (call $fits (global.get $piece) (global.get $rot)
                    (i32.sub (global.get $px) (i32.const 1)) (global.get $py))
                (then (global.set $px (i32.sub (global.get $px) (i32.const 1)))
                  (global.set $locktimer (i32.const 0))))))
            (if (i32.and (local.get $btn) (i32.const 2048))
              (then (if (call $fits (global.get $piece) (global.get $rot)
                    (i32.add (global.get $px) (i32.const 1)) (global.get $py))
                (then (global.set $px (i32.add (global.get $px) (i32.const 1)))
                  (global.set $locktimer (i32.const 0))))))))

        (local.set $delay (i32.sub (i32.const 48) (i32.mul (global.get $level) (i32.const 4))))
        (if (i32.lt_s (local.get $delay) (i32.const 2)) (then (local.set $delay (i32.const 2))))
        (if (i32.and (local.get $btn) (i32.const 512)) (then (local.set $delay (i32.const 2))))

        (if (call $fits (global.get $piece) (global.get $rot)
              (global.get $px) (i32.add (global.get $py) (i32.const 1)))
          (then
            (global.set $locktimer (i32.const 0))
            (global.set $drop (i32.add (global.get $drop) (i32.const 1)))
            (if (i32.ge_s (global.get $drop) (local.get $delay))
              (then
                (global.set $drop (i32.const 0))
                (global.set $py (i32.add (global.get $py) (i32.const 1)))
                (if (i32.and (local.get $btn) (i32.const 512))
                  (then (global.set $score (i32.add (global.get $score) (i32.const 1))))))))
          (else
            ;; A grounded piece gets half a second to slide or rotate.
            (global.set $locktimer (i32.add (global.get $locktimer) (i32.const 1)))
            (if (i32.ge_u (global.get $locktimer) (i32.const 30))
              (then (call $finish_piece))))))))

    (if (i32.and (local.get $btn) (i32.const 3072))
      (then (global.set $repeat (i32.add (global.get $repeat) (i32.const 1))))
      (else (global.set $repeat (i32.const 0))))
    (call $ensure_active_valid)
    (global.set $oldbtn (local.get $btn))
    (call $draw) (call $audio))

)
